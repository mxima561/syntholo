{
  "name": "@syntholo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./config": "./src/config.ts",
    "./errors": "./src/plugins/error-handler.ts"
  },
  "scripts": {
    "build": "node ../../infra/scripts/build-node-service.mjs api",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint --config ../../eslint.config.mjs src vitest.config.ts vitest.integration.config.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@syntholo/contracts": "^0.1.0",
    "@syntholo/database": "^0.1.0",
    "@syntholo/domain": "^0.1.0",
    "@syntholo/integrations": "^0.1.0",
    "fastify": "5.11.3",
    "fastify-plugin": "6.0.0",
    "fastify-raw-body": "6.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@syntholo/testing": "^0.1.0",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "22.22.2",
    "npm": "10.9.7"
  }
}
