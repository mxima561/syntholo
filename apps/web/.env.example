# Runtime (shared)
APP_MODE=demo
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
DATABASE_URL=

# Staff seed (never auto-provisions on login)
STAFF_BOOTSTRAP_EMAILS=

# --- apps/web (students) ---
# Clerk US instance. Do not persist student PII in Clerk metadata.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- apps/admin (staff) ---
# Cloudflare Access application AUD tag and team domain (https://<team>.cloudflareaccess.com)
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=
# Local only: NODE_ENV must not be production, and CF_ACCESS_AUD must be unset.
ADMIN_DEV_BYPASS_EMAIL=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DATABASE=syntholo

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Optional HighLevel white-label implementation
HIGHLEVEL_API_KEY=
HIGHLEVEL_LOCATION_ID=
