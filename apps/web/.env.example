# Runtime (shared)
# Production web (APP_MODE=production) requires DATABASE_URL, Neon Auth, Neon Data API, and Stripe.
APP_MODE=demo
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
DATABASE_URL=

# Staff seed (never auto-provisions on login)
STAFF_BOOTSTRAP_EMAILS=

# --- Neon Auth ---
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_NEON_AUTH_URL=
NEXT_PUBLIC_NEON_DATA_API_URL=
NEXT_PUBLIC_NEON_AUTH_GOOGLE=false

# --- apps/admin ---
# Production admin origin (admin.syntholo.com) uses Cloudflare Access env from the
# admin Vercel project. Leave these unset for local web development.
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=
ADMIN_DEV_BYPASS_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
