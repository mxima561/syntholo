{
  "name": "@syntholo/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/runner.ts",
    "./config": "./src/config.ts",
    "./cron": "./src/cron.ts",
    "./health": "./src/health.ts"
  },
  "scripts": {
    "build": "node ../../infra/scripts/build-node-service.mjs worker",
    "dev": "tsx watch src/runner.ts",
    "dev:cron": "tsx watch src/cron.ts",
    "generate:certificate-font-repertoire": "node scripts/generate-certificate-font-repertoire.mjs",
    "lint": "eslint --config ../../eslint.config.mjs src vitest.config.ts vitest.integration.config.ts",
    "start": "node dist/runner.js",
    "start:cron": "node dist/cron.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@syntholo/database": "^0.1.0",
    "@syntholo/domain": "^0.1.0",
    "@syntholo/integrations": "^0.1.0",
    "pdf-lib": "1.17.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@syntholo/testing": "^0.1.0",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "22.22.2",
    "npm": "10.9.7"
  }
}
