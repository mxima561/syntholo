{
  "name": "syntholo-platform",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": "22.22.2",
    "npm": "10.9.7"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:schema:check": "npm run db:schema:check -w @syntholo/database",
    "dev:web": "npm run dev -w @syntholo/web",
    "dev:api": "npm run dev -w @syntholo/api",
    "dev:worker": "npm run dev -w @syntholo/worker",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:migrate": "node infra/scripts/build-node-service.mjs migrate",
    "gate:foundation": "node infra/scripts/gate-foundation.mjs",
    "test:e2e": "npm run test:e2e -w @syntholo/web"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
