# Runtime (shared)
# Production web (APP_MODE=production) requires DATABASE_URL, Clerk, and Stripe.
APP_MODE=demo
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
DATABASE_URL=

# Staff seed (never auto-provisions on login)
STAFF_BOOTSTRAP_EMAILS=

# --- apps/web (students) ---
# Clerk US instance. Do not persist student PII in Clerk metadata.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- apps/admin (staff) ---
# Cloudflare Access application AUD tag and team domain (https://<team>.cloudflareaccess.com)
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=
# Local only: NODE_ENV must not be production, and CF_ACCESS_AUD must be unset.
ADMIN_DEV_BYPASS_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostHog (optional; set key and host together)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
