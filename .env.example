# Every built/deployed artifact requires the exact checked-out 40-character Git SHA.
RELEASE_SHA=

# API mode is mandatory: development locally, production in every release.
NODE_ENV=development

# Web only — never place database or privileged provider credentials here.
APP_MODE=demo
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
API_UPSTREAM_ORIGIN=http://localhost:4000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# API only — store values in the API service's secret store.
MEMBER_DATABASE_URL=
STAFF_DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUDIENCE=syntholo-member-api
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_ORGANIZATION_ID=
WORKOS_ISSUER=
WORKOS_JWKS_URL=
STAFF_SESSION_ENCRYPTION_KEYS=

# Worker/cron only — a LOGIN inheriting exactly syntholo_worker.
DATABASE_URL=
WORKER_CONCURRENCY=4
WORKER_IDLE_DELAY_MS=1000

# Migration release job only. Never load these into API, worker, cron, or web.
DATABASE_MIGRATION_TARGET=production
DATABASE_DIRECT_URL=
