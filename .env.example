# Runtime (shared)
# Production web (APP_MODE=production) requires DATABASE_URL, Neon Auth, Neon Data API, and Stripe.
APP_MODE=demo
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
DATABASE_URL=

# Staff seed (never auto-provisions on login). First matching Neon Auth sign-in binds user_id.
STAFF_BOOTSTRAP_EMAILS=

# --- Neon Auth (canonical identity for students, teachers, school admins, and staff) ---
# Auth URL from the Neon console Auth page. Safe to expose the public URL; cookie secret is server-only.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_NEON_AUTH_URL=
NEXT_PUBLIC_NEON_DATA_API_URL=
NEXT_PUBLIC_NEON_AUTH_GOOGLE=false

# --- apps/admin (staff origin, typically admin.syntholo.com) ---
# Cloudflare Access is an outer gate only. It does not identify Syntholo users.
# Set these on the admin Vercel project in production. Leave them unset for local
# `next dev` and Vercel preview unless you have put Access in front of that URL.
# Application AUD tag and team domain (https://<team>.cloudflareaccess.com)
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=
# Local next dev only. Preview and production builds fail if this is set.
ADMIN_DEV_BYPASS_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostHog (optional; set key and host together)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- apps/api ---
API_URL=
API_PORT=4000
WORKER_PORT=4001

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
